{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimikit",
  "version": "0.12.0",
  "identifier": "dev.sanchezroberto.assetden",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mimikit",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; worker-src 'self' blob:",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Game asset browser",
    "longDescription": "Browse, preview, tag and drag the game assets in your folders into your engine.",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English", "SpanishInternational", "PortugueseBR", "French", "German", "Japanese", "SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERDFERUI3OEUwNUNDRDgKUldUWXpBV090OTdSelNZWXNvS0FWMXAzLy9Fbk1RY21MK3licnp3VE1UdEovVWpmUTJYTCtFUnQK",
      "endpoints": [
        "https://github.com/sanchezrobertodev/mimikit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
